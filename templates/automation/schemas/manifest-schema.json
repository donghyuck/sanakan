{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "baseline": {
      "type": "string",
      "pattern": "[0-9a-f]{40}|[0-9a-f]{64}"
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "baseline",
    "patch_sha256",
    "changed_files"
  ],
  "additionalProperties": false
}
