{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "failed",
        "no_change"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unverified_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pm_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "string",
      "pattern": "[0-9a-f]{40}|[0-9a-f]{64}"
    },
    "acceptance_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "met": {
            "type": "boolean"
          }
        },
        "required": [
          "criterion",
          "evidence",
          "met"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "summary",
    "changed_files",
    "verification_commands",
    "verification_results",
    "unverified_items",
    "risks",
    "pm_questions",
    "rollback",
    "baseline",
    "acceptance_results"
  ],
  "additionalProperties": false
}
