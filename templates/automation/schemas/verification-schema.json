{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "baseline": {
      "type": "string",
      "pattern": "[0-9a-f]{40}|[0-9a-f]{64}"
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exit_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": [
    "baseline",
    "patch_sha256",
    "status",
    "commands",
    "exit_codes"
  ],
  "additionalProperties": false
}
